# Copy to keystore.properties (git-ignored) to sign local release builds.
#
# CI does not use this file - it reads the same values from the environment:
#   storeFile     -> KEYSTORE_FILE
#   storePassword -> KEYSTORE_PASSWORD
#   keyAlias      -> KEY_ALIAS
#   keyPassword   -> KEY_PASSWORD
#
# Create an upload key with:
#   keytool -genkeypair -v -keystore upload-keystore.jks -alias upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Paths are resolved relative to the app/ module.

storeFile=../upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
